  _disableTexts: 0
  _russianText: "\u042D\u0442\u043E \u0448\u043A\u0430\u043B\u0430 \u0432\u0430\u0448\u0438\u0445
    \u043E\u0447\u043A\u043E\u0432. \u0417\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0443\u0431\u0438\u0442\u043E\u0433\u043E \u0437\u043E\u043C\u0431\u0438 \u0432\u044B
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043E\u0434\u043D\u043E
