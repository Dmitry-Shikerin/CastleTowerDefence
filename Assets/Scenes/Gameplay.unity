  m_text: "\u042D\u0442\u043E \u0432\u0430\u0448\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.
    \u041F\u0435\u0440\u0432\u0430\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0430\u0442\u043E\u043C\u043D\u0443\u044E
    \u0431\u043E\u043C\u0431\u0443 \u043D\u0430 \u0437\u043E\u043C\u0431\u0438. \u0412\u0442\u043E\u0440\u0430\u044F
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
    \u0432\u0441\u0435\u0445 \u0432\u0430\u0448\u0438\u0445 \u0431\u043E\u0439\u0446\u043E\u0432.
    \u0422\u0440\u0435\u0442\u044C\u044F \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
